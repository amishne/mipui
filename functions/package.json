{
  "name": "functions",
  "description": "Cloud Functions for Mipui Cold Storage",
  "scripts": {
    "serve": "firebase emulators:start --only functions",
    "shell": "firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "test": "mocha test/index.test.js",
    "test:integration": "firebase emulators:exec --project test \"mocha test/integration.test.js\""
  },
  "engines": {
    "node": "18"
  },
  "main": "index.js",
  "dependencies": {
    "firebase-admin": "^13.6.0",
    "firebase-functions": "^7.0.5"
  },
  "private": true,
  "devDependencies": {
    "chai": "^4.5.0",
    "firebase-functions-test": "^3.4.1",
    "mocha": "^11.7.5",
    "sinon": "^21.0.1"
  }
}
